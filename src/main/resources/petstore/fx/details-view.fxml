<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="petstore.fx.controller.DetailsController"
      stylesheets="@app.css"
      styleClass="form-card"
      prefWidth="460"
      spacing="14">
    <Label fx:id="titleLabel" styleClass="section-title"/>
    <Label fx:id="bodyLabel" wrapText="true"/>
    <HBox alignment="CENTER_RIGHT">
        <Button text="Закрыть" onAction="#onClose" defaultButton="true" styleClass="primary-button"/>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="petstore.fx.controller.ClientFormController"
      stylesheets="@app.css"
      styleClass="form-card"
      prefWidth="480"
      spacing="14">
    <Label fx:id="formTitle" text="Новый клиент" styleClass="section-title"/>
    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
        </columnConstraints>
        <Label text="ФИО" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Иванова Анна" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Телефон" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="+79001111111" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="anna@mail.ru" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
        <Button text="Сохранить" onAction="#onSave" defaultButton="true" styleClass="primary-button"/>
    </HBox>
</VBox>
